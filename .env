# ==============================================================================
# CivicLens AI Backend - Environment Configuration
# ==============================================================================
# IMPORTANT: Never commit this file to version control.
# Add ".env" to your .gitignore. Use ".env.example" (with dummy values) for
# sharing config structure with your team.
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME=CivicLens AI
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=False
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# POSTGRESQL DATABASE
# ------------------------------------------------------------------------------
POSTGRES_USER=civiclens_user
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=civiclens_db

# ------------------------------------------------------------------------------
# SQLALCHEMY DATABASE URL
# ------------------------------------------------------------------------------
# Sync URL (Alembic migrations)
DATABASE_URL=postgresql://civiclens_user:CHANGE_ME_strong_db_password@localhost:5432/civiclens_db
# Async URL (SQLAlchemy 2.0 async engine - asyncpg driver)
ASYNC_DATABASE_URL=postgresql+asyncpg://civiclens_user:CHANGE_ME_strong_db_password@localhost:5432/civiclens_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=False

# ------------------------------------------------------------------------------
# JWT AUTHENTICATION
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32_generated_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# CLOUDINARY (Media Storage)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=civiclens-cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=CHANGE_ME_cloudinary_api_secret
CLOUDINARY_SECURE=True

# ------------------------------------------------------------------------------
# EMAIL (SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
EMAIL_USERNAME=notifications@civiclens.ai
EMAIL_PASSWORD=CHANGE_ME_smtp_app_password
EMAIL_FROM=CivicLens AI <notifications@civiclens.ai>

# ------------------------------------------------------------------------------
# UPLOAD CONFIGURATION
# ------------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp

# ------------------------------------------------------------------------------
# AI CONFIGURATION (YOLOv8 / OpenCV)
# ------------------------------------------------------------------------------
YOLO_MODEL_PATH=./models/yolov8_civiclens.pt
YOLO_CONFIDENCE_THRESHOLD=0.45
YOLO_IOU_THRESHOLD=0.50
YOLO_DEVICE=cpu

# ------------------------------------------------------------------------------
# LOGGING (Loguru)
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=./logs/civiclens.log
LOG_ROTATION=10 MB
LOG_RETENTION=30 days

# ------------------------------------------------------------------------------
# CORS
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=https://civiclens.ai,https://www.civiclens.ai,http://localhost:3000
ALLOW_CREDENTIALS=True

# ------------------------------------------------------------------------------
# REDIS (Optional - Caching / Task Queue)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_URL=redis://:CHANGE_ME_redis_password@localhost:6379/0

# ------------------------------------------------------------------------------
# RATE LIMITING
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60